{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aoitan/isohyps/schemas/machine-index.schema.json",
  "title": "isohyps machine index",
  "description": "Public, versioned machine_index.json contract. The current producer emits v2.2 with structured attention, a digest-bound document-freshness reference, and optional module summaries; v2.0, v2.1, and v1 remain readable through the version-aware runtime API.",
  "type": "object",
  "required": [
    "schema_version",
    "files",
    "dependency_graph",
    "dependency_order"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "description": "Decimal major.minor version string. The initial producer version is 1.0; major changes are not backward compatible."
    },
    "files": {
      "type": "array",
      "description": "File entries sorted by their repository-relative POSIX path. Path uniqueness and ordering are checked by the runtime contract validator.",
      "items": {
        "$ref": "#/$defs/fileEntry"
      }
    },
    "dependency_graph": {
      "type": "object",
      "description": "Mapping from a source file to its direct internal dependencies. Keys and adjacency arrays are sorted by path; graph consistency is checked by the runtime contract validator.",
      "propertyNames": {
        "$ref": "#/$defs/repositoryRelativePath"
      },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/repositoryRelativePath"
        }
      }
    },
    "dependency_order": {
      "type": "array",
      "uniqueItems": true,
      "description": "Dependency-first path order. Acyclic edges place dependencies before dependents; cycle fallback ordering is deterministic but is not a strict topological order.",
      "items": {
        "$ref": "#/$defs/repositoryRelativePath"
      }
    },
    "attention": {
      "type": "array",
      "items": { "$ref": "#/$defs/attentionEntry" }
    },
    "doc_freshness": {
      "$ref": "#/$defs/docFreshnessReference"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "pattern": "^2\\.(?:0|[1-9][0-9]*)$" } } },
      "then": { "required": ["attention"] }
    },
    {
      "if": {
        "properties": {
          "schema_version": { "pattern": "^2\\.(?:[1-9][0-9]*)$" }
        }
      },
      "then": { "required": ["doc_freshness"] }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "pattern": "^2\\.(?:[2-9]|[1-9][0-9]+)$"
          }
        }
      },
      "then": {
        "properties": {
          "files": {
            "items": {
              "if": { "required": ["module_summary"] },
              "then": {
                "properties": {
                  "module_summary": {
                    "$ref": "#/$defs/moduleSummary"
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "additionalProperties": true,
  "$defs": {
    "repositoryRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*\\u0000)(?!.*//)(?!.*(?:^|/)(?:\\.|\\.\\.)(?:/|$))(?!.*\/$).+$",
      "description": "Normalized repository-relative POSIX path. Absolute paths, Windows drive paths, backslashes, NULs, empty segments, and '.' or '..' segments are invalid."
    },
    "attentionEntry": {
      "type": "object",
      "required": ["severity", "kind", "path", "reason", "evidence"],
      "properties": {
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "kind": { "enum": ["large_file", "test_missing", "todo_increase", "high_fan_in", "high_fan_out", "doc_missing", "doc_stale"] },
        "path": { "$ref": "#/$defs/repositoryRelativePath" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "object",
          "additionalProperties": { "type": ["string", "integer", "boolean", "null"] }
        }
      },
      "additionalProperties": false
    },
    "docFreshnessReference": {
      "type": "object",
      "required": ["path", "schema_version", "sha256", "counts"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryRelativePath" },
        "schema_version": {
          "type": "string",
          "pattern": "^1\\.(?:0|[1-9][0-9]*)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "counts": {
          "type": "object",
          "required": ["missing", "fresh", "stale", "unknown"],
          "properties": {
            "missing": { "type": "integer", "minimum": 0 },
            "fresh": { "type": "integer", "minimum": 0 },
            "stale": { "type": "integer", "minimum": 0 },
            "unknown": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "moduleSummaryEvidence": {
      "type": "object",
      "required": [
        "kind",
        "origin",
        "line",
        "value",
        "value_truncated",
        "paragraphs_omitted"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "module_docstring",
            "definition",
            "entrypoint_candidate"
          ]
        },
        "origin": {
          "type": "string",
          "enum": [
            "python_ast",
            "tree_sitter",
            "regex",
            "attention_entrypoint_resolver_v1"
          ]
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "value_truncated": {
          "type": "boolean"
        },
        "paragraphs_omitted": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": { "const": "module_docstring" }
            }
          },
          "then": {
            "properties": {
              "origin": { "const": "python_ast" },
              "line": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "definition" }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "enum": ["python_ast", "tree_sitter", "regex"]
              },
              "paragraphs_omitted": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "entrypoint_candidate" }
            }
          },
          "then": {
            "properties": {
              "origin": {
                "const": "attention_entrypoint_resolver_v1"
              },
              "line": { "const": null },
              "value": { "const": "Entrypoint candidate detected." },
              "paragraphs_omitted": { "const": false }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "moduleSummary": {
      "type": "object",
      "required": [
        "text",
        "method",
        "reason",
        "parser",
        "evidence",
        "omitted_evidence_count",
        "text_truncated"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "method": {
          "type": "string",
          "enum": ["module_docstring", "structural_facts", "unknown"]
        },
        "reason": {
          "type": ["string", "null"],
          "enum": [
            null,
            "read_error",
            "decode_error",
            "parse_error",
            "unsupported",
            "binary_skipped",
            "source_changed",
            "insufficient_evidence"
          ]
        },
        "parser": {
          "type": "string",
          "enum": ["python_ast", "tree_sitter", "regex", "none"]
        },
        "evidence": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/moduleSummaryEvidence" }
        },
        "omitted_evidence_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "text_truncated": {
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": { "const": "module_docstring" }
            }
          },
          "then": {
            "properties": {
              "reason": { "const": null },
              "parser": { "const": "python_ast" },
              "evidence": {
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "properties": {
                    "kind": { "const": "module_docstring" }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": { "const": "structural_facts" }
            }
          },
          "then": {
            "properties": {
              "reason": { "const": null },
              "evidence": {
                "minItems": 1,
                "contains": {
                  "properties": {
                    "kind": {
                      "enum": ["definition", "entrypoint_candidate"]
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": { "const": "unknown" }
            }
          },
          "then": {
            "properties": {
              "text": { "const": "unknown" },
              "reason": {
                "enum": [
                  "read_error",
                  "decode_error",
                  "parse_error",
                  "unsupported",
                  "binary_skipped",
                  "source_changed",
                  "insufficient_evidence"
                ]
              },
              "evidence": { "maxItems": 0 },
              "omitted_evidence_count": { "const": 0 },
              "text_truncated": { "const": false }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "fileEntry": {
      "type": "object",
      "required": [
        "path",
        "hash",
        "size",
        "language",
        "kind",
        "public_symbols",
        "internal_symbols",
        "fan_in",
        "fan_out"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryRelativePath",
          "description": "Stable file identity relative to the scan root."
        },
        "hash": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{64}|binary_skipped|error)$",
          "description": "Lowercase SHA-256 content digest for readable text, or the existing binary_skipped/error sentinel."
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "description": "File size in bytes at scan time."
        },
        "language": {
          "type": "string",
          "description": "Value returned by the existing language detector; unknown is used when no language is detected."
        },
        "kind": {
          "type": "string",
          "enum": [
            "source",
            "test",
            "config",
            "doc",
            "other"
          ],
          "description": "Existing file classification."
        },
        "public_symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Public symbols in the existing classes-then-functions extraction order."
        },
        "internal_symbols": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Internal symbols in the existing classes-then-functions extraction order."
        },
        "fan_in": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of direct incoming dependency edges."
        },
        "fan_out": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of direct dependencies listed for this file."
        },
        "module_summary": {
          "description": "Optional v2.2+ source-module summary. Its contract is version-gated so older readers can preserve unknown fields."
        }
      },
      "additionalProperties": true
    }
  }
}
